# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets / local config
.env
*.bak
.env.legacy.bak
stack.env
# Rendered by stack.sh at launch (base livekit.yaml + webhook section)
livekit-server/livekit.runtime.yaml

# Runtime
logs/
*.log

# Caddy state (created by docker compose)
caddy_data/
caddy_config/

# Stray model artifacts (should be baked into the image, not committed)
*.onnx
*.bin

# Vendored LiveKit server binaries (~66MB each) — keep on disk, don't commit.
# Remove this line if you want the prebuilt binary committed with the repo.
livekit-server/bin/

# OS
.DS_Store
Thumbs.db

# Local tooling
.claude/settings.local.json
