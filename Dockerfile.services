# Shared image for the STT (faster-whisper) and TTS (Kokoro) servers.
# Both models are baked in so containers never download at runtime.
# docker-compose runs this image twice with different commands.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-services.txt .
RUN pip install -r requirements-services.txt

# ── Bake models ──────────────────────────────────────────────────────────────
# Kokoro TTS (matches the cache path tts_server.py expects)
RUN mkdir -p /root/.cache/kokoro-onnx && \
    curl -L -o /root/.cache/kokoro-onnx/kokoro-v1.0.onnx \
        https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx && \
    curl -L -o /root/.cache/kokoro-onnx/voices-v1.0.bin \
        https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin

# Whisper STT (populates the HuggingFace cache layer)
ARG WHISPER_MODEL=base
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('${WHISPER_MODEL}', device='cpu', compute_type='int8')"

COPY stt_server.py tts_server.py ./

# Command is supplied by docker-compose (stt_server.py or tts_server.py).
CMD ["python", "stt_server.py"]
