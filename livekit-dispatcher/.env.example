# Dispatcher config — copy to .env and fill in. Only needed when running the
# dispatcher standalone; ./stack.sh exports these from stack.env instead.
# Key/secret must match the keys the LiveKit server was started with.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-to-a-random-secret
LIVEKIT_URL=ws://localhost:7880

# Dispatcher server port (LiveKit webhooks POST to http://localhost:<PORT>/webhook)
PORT=3001

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Agent worker to dispatch into each new room. Must match agent.py's
# WorkerOptions(agent_name=...).
DISPATCH_AGENT_NAME=voice-agent

# Recording/egress is OFF unless an upload backend is configured. Leave these
# unset for the personal assistant.
# EGRESS_AZURE_ACCOUNT_NAME=
# EGRESS_AZURE_ACCOUNT_KEY=
# EGRESS_AZURE_CONTAINER=
# EGRESS_FILEPATH={room_name}.ogg
# EGRESS_LOCAL_DIR=./
