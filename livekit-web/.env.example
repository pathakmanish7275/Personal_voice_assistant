# Web token server config — copy to .env and fill in. Only needed when running
# it standalone; ./stack.sh exports these from stack.env instead.
# Key/secret must match the keys the LiveKit server was started with.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-to-a-random-secret

# URL the browser uses to reach the LiveKit server.
# localhost works for same-machine testing; use your LAN IP / domain otherwise.
LIVEKIT_WS_URL=ws://localhost:7880

# Port this page + token server listens on
WEB_PORT=8080
