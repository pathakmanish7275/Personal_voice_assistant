# ── Personal Voice Assistant — config template ───────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# LiveKit (self-hosted). Key/secret are arbitrary but MUST match across services.
# Generate a secret with:  python -c "import secrets; print(secrets.token_hex(24))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-random-secret

# Agent -> server, inside the docker network (no TLS needed here)
LIVEKIT_URL=ws://livekit:7880
# Browser -> server, via the Caddy HTTPS proxy. Used by the token server.
# Set the host to this machine's LAN IP.
LIVEKIT_WS_PUBLIC=wss://192.168.1.9
# Host LAN IP that LiveKit advertises for WebRTC media. Find it with `hostname -I`
# (Linux), `ipconfig getifaddr en0` (macOS), or `ipconfig` (Windows).
LIVEKIT_NODE_IP=192.168.1.9

# Ollama runs NATIVELY on the host (GPU). Start it with: ollama serve
# Native agent uses localhost. The dockerized agent (docker-compose.yml) overrides
# this to host.docker.internal automatically — leave localhost here.
# (For the full Docker LAN stack, also run Ollama with OLLAMA_HOST=0.0.0.0.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# ── Provider selection (modular, like LiveKit's cloud plugins) ───────────────
# Each stage is swappable. "local" runs in-process; "openai" points the OpenAI
# plugin at any OpenAI-compatible endpoint — a local Docker service OR the cloud.
# Defaults keep everything local/in-process. ./experiment.sh sets these to the
# Docker STT/TTS providers automatically; set them here for other setups.

# STT_PROVIDER=local        # local | openai
# STT_BASE_URL=http://localhost:8001/v1   # local Docker STT, or https://api.openai.com/v1
# STT_MODEL=whisper         # any non-"whisper-1" => simple json response
# STT_API_KEY=local         # real key when using the cloud

# LLM_PROVIDER=ollama       # ollama | openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# TTS_PROVIDER=local        # local | openai
# TTS_BASE_URL=http://localhost:8002/v1   # local Docker TTS, or https://api.openai.com/v1
# TTS_MODEL=tts-1           # tts-1 => raw audio stream (works local & cloud)

# In-process Whisper STT (STT_PROVIDER=local). Sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Kokoro TTS voice (TTS_PROVIDER=local): af_heart, af_sky, af_bella, bm_lewis, am_adam
# (For cloud OpenAI TTS use: alloy, echo, fable, onyx, nova, shimmer)
TTS_VOICE=af_heart

# Token server port (internal; fronted by Caddy at /token)
TOKEN_PORT=8080

# ── search_my_work tool (local vector search over the user's notes) ───────────
# SEARCH_URL=http://127.0.0.1:8766/search
# SEARCH_MODE=vector
# SEARCH_TOP_K=4            # how many chunks to feed the LLM
# SEARCH_CHUNK_CHARS=600    # max chars per chunk
