# ── Personal Voice Assistant — config template ───────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# LiveKit (self-hosted). Key/secret are arbitrary but MUST match across services.
# Generate a secret with:  python -c "import secrets; print(secrets.token_hex(24))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-random-secret

# Agent -> server, inside the docker network (no TLS needed here)
LIVEKIT_URL=ws://livekit:7880
# Browser -> server, via the Caddy HTTPS proxy. Used by the token server.
# Set the host to this machine's LAN IP.
LIVEKIT_WS_PUBLIC=wss://192.168.1.9
# Host LAN IP that LiveKit advertises for WebRTC media. Find it with `hostname -I`
# (Linux), `ipconfig getifaddr en0` (macOS), or `ipconfig` (Windows).
LIVEKIT_NODE_IP=192.168.1.9

# Ollama runs NATIVELY on the host (GPU). Start it with: OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# In-process Whisper STT. Sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Kokoro TTS voice: af_heart, af_sky, af_bella, bm_lewis, am_adam
TTS_VOICE=af_heart

# Token server port (internal; fronted by Caddy at /token)
TOKEN_PORT=8080
