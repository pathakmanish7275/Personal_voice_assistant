# Credentials for the self-hosted binary stack (./stack.sh, option 4).
# Copy to stack.env (gitignored) — or just run ./stack.sh once and it generates
# stack.env with a fresh random key/secret for you.
#
# The key/secret are arbitrary, but every component (server, dispatcher, web
# token server, agent) must share them; stack.sh hands them to all four.
# Generate a secret with:  python3 -c "import secrets; print(secrets.token_hex(24))"
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-to-a-random-secret
